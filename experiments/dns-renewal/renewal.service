[Unit]
Description=Renew and verify only the RBX synthetic DNSSEC publication
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
User=rbx-dns-renewer
ExecStart=/usr/bin/python3 -B /opt/rbx-dns-renewal/renewer.py --release /opt/rbx-dns-renewal --state-dir /var/lib/rbx-dns-renewal
LoadCredentialEncrypted=signer:/etc/credstore.encrypted/rbx-dns-renewal-signer
LoadCredentialEncrypted=publisher:/etc/credstore.encrypted/rbx-dns-renewal-publisher
LoadCredentialEncrypted=healthchecks:/etc/credstore.encrypted/rbx-dns-renewal-healthchecks
StateDirectory=rbx-dns-renewal
StateDirectoryMode=0700
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=20%
TasksMax=32
TimeoutStartSec=300
